{
  "name": "employee-management-server",
  "version": "1.0.0",
  "description": "Backend API for Employee Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test tests/**/*.test.js",
    "test:db": "node src/scripts/test-db.js",
    "setup:db": "node src/scripts/setup-db.js",
    "setup:gui": "powershell -ExecutionPolicy Bypass -File src/scripts/setup-gui.ps1",
    "set:password": "node src/scripts/set-password.js",
    "set:password:gui": "powershell -ExecutionPolicy Bypass -File src/scripts/set-password-gui.ps1"
  },
  "keywords": [
    "employee-management",
    "express",
    "mongoose",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
